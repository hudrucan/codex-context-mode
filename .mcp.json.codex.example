{
  "_comment": "Standalone Codex local-fork example. Replace the absolute launcher path with the reviewed checkout; never resolve context-mode from npm global. Requests route by thread identity; an explicit CONTEXT_MODE_PROJECT_DIR pin is optional.",
  "mcpServers": {
    "context-mode": {
      "command": "node",
      "args": [
        "/absolute/path/to/codex-context-mode/start.mjs"
      ]
    }
  }
}
