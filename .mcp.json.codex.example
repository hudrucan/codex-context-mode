{
  "_comment": "Standalone Codex configuration. Replace the absolute start.mjs path. MCP requests use thread identity; CONTEXT_MODE_PROJECT_DIR can explicitly pin a workspace.",
  "mcpServers": {
    "context-mode": {
      "command": "node",
      "args": [
        "/absolute/path/to/context-mode/start.mjs"
      ]
    }
  }
}
